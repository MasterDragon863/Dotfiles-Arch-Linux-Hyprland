{
    "layer": "top",
    "position": "top",
    "height": 45,
    "margin-left": 20,
    "margin-right": 20,
    "margin-top": 10,
    "exclusive": true,

    "include": [
        "~/.config/waybar/modules.jsonc"
    ],

    "modules-left": ["memory", "disk", "hyprland/window"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["custom/media", "battery", "pulseaudio", "network", "clock",]
}
